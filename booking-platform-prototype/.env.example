# Скопируйте в .env перед запуском: cp .env.example .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET=change-me-in-production

# 22-символьный base64url ID кластера Kafka в формате KRaft.
# Можно сгенерировать свой: kafka-storage.sh random-uuid
KAFKA_KRAFT_CLUSTER_ID=jEZ_Ey8-SSiiLm0Z0Fzkvg

# Доля отказов мок-платежа (0..1). 1.0 — всегда payment.failed, удобно для демо саги.
PAYMENT_FAILURE_RATE=0.1
