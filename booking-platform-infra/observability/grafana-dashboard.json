{
  "title": "Booking Platform — Блок 2",
  "uid": "booking-block2",
  "tags": ["booking", "block2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Kafka — лаг консьюмеров саги",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Лаг consumer group по топикам",
      "description": "Необработанные сообщения. Рост = consumer не успевает; именно по этой метрике KEDA масштабирует payment-service.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Суммарный лаг payment-service (триггер KEDA)",
      "description": "Значение, которое KEDA сравнивает с lagThreshold=5.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"payment-service\", topic=\"booking.created\"})",
          "legendFormat": "lag booking.created",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Автоскейлинг (HPA / KEDA)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Реплики сервисов",
      "description": "Фактическое число подов. Ступеньки = события масштабирования.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 0, "lineWidth": 2, "lineInterpolation": "stepAfter" }
        }
      },
      "targets": [
        {
          "expr": "sum by (deployment) (kube_deployment_status_replicas_ready{namespace=\"booking\"})",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HPA: текущие / желаемые / максимум",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"booking\"}",
          "legendFormat": "{{horizontalpodautoscaler}} — текущие",
          "refId": "A"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"booking\"}",
          "legendFormat": "{{horizontalpodautoscaler}} — желаемые",
          "refId": "B"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"booking\"}",
          "legendFormat": "{{horizontalpodautoscaler}} — максимум",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Istio — латентность и ошибки",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "RPS по коду ответа",
      "description": "Видно и нормальный трафик, и всплеск 429 от rate limiter, и 5xx при сбое сервиса.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } } }
      },
      "targets": [
        {
          "expr": "sum by (response_code) (rate(istio_requests_total{reporter=\"source\"}[1m]))",
          "legendFormat": "HTTP {{response_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Латентность запросов p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\"}[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\"}[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Доля 5xx по сервисам назначения",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum by (destination_service_name) (rate(istio_requests_total{response_code=~\"5..\"}[2m])) / clamp_min(sum by (destination_service_name) (rate(istio_requests_total[2m])), 0.001)",
          "legendFormat": "{{destination_service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Rate limiter и circuit breaker",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "429 от Envoy Rate Limit Service",
      "description": "Запросы, отбитые лимитом 20 rps на клиентский IP.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 30 } } },
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{response_code=\"429\"}[1m]))",
          "legendFormat": "429/с",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Всего 429 за период",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 4, "x": 8, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(istio_requests_total{response_code=\"429\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Circuit breaker: активные исключения подов (outlier detection)",
      "description": "Больше нуля = Envoy вывел нездоровый под из пула балансировки.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 25, "lineWidth": 2, "lineInterpolation": "stepAfter" }
        }
      },
      "targets": [
        {
          "expr": "sum by (cluster_name) (envoy_cluster_outlier_detection_ejections_active)",
          "legendFormat": "{{cluster_name}}",
          "refId": "A"
        },
        {
          "expr": "sum by (cluster_name) (rate(envoy_cluster_outlier_detection_ejections_enforced_total[1m]))",
          "legendFormat": "исключений/с — {{cluster_name}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Состояние подов",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Рестарты контейнеров",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 43 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"booking|kafka|istio-system\"}[10m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU подов booking (для HPA по CPU)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 43 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"booking\", container!=\"\", container!=\"istio-proxy\"}[2m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ]
}
